# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.env
venv/
env/
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Application data ──────────────────────────────────────────────────────
backend/checkpoints/*
!backend/checkpoints/.gitkeep
backend/cache_workspace/
backend/logs/
backend/runtime/
backend/rotofox_config.json
pretrained_models/
scripts/pretrained_models/
backend/third_party/
*.pt
*.pth

# ── Node / frontend ───────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Rust / Tauri ──────────────────────────────────────────────────────────
frontend/src-tauri/target/
frontend/src-tauri/resources/
# PyInstaller sidecar output (~2 GB). Rebuild with:
#   backend/.venv/Scripts/python scripts/package_backend.py
frontend/src-tauri/binaries/

# ── PyInstaller ───────────────────────────────────────────────────────────
backend/build/
backend/dist/
# NOTE: rotofox-backend.spec is intentionally NOT ignored. It is the single
# source of truth for how the backend is packaged and must stay in version
# control. A blanket "*.spec" rule previously claimed to ignore it while the
# file was in fact tracked, so edits appeared to vanish on commit.

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Archives & binaries ───────────────────────────────────────────────────
*.zip
*.7z
*.exe
*.dll
*.pyd
*.so

# ── Local tooling ─────────────────────────────────────────────────────────
graphify-out/
.agents/
